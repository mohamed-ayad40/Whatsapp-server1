datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

model User {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  email            String?     @unique  // اتغير لـ optional
  phoneNumber      String?     @unique  // جديد
  name             String
  profilePicture   String      @default("")
  about            String      @default("")
  sentMessages     Messages[]  @relation("sentMessages")
  receivedMessages Messages[]  @relation("receivedMessages")
  lastSeen         DateTime?   @default(now()) 
  groupKeys        GroupKey[]
  groupIds         String[]    @db.ObjectId
  groups           Group[]     @relation(fields: [groupIds], references: [id])
  seenMessages     MessageSeen[] 
  
  // 🚨 مفاتيح التشفير 🚨
  publicKey        String?     // 👈 مفتاح RSA للجروبات
  ecdhPublicKey    String?     // 👈 مفتاح ECDH للشات الفردي (الإضافة الجديدة)
  
  blockedUsers     String[]    @db.ObjectId
  blockedBy        String[]    @db.ObjectId
}

model Group {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  profilePicture String?
  userIds        String[]    @db.ObjectId
  adminIds       String[]    @db.ObjectId
  isLocked       Boolean     @default(false)
  messages       Messages[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime?   @updatedAt
  encryptedKeys  GroupKey[]

  users          User[]      @relation(fields: [userIds], references: [id])
}

model Messages {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  sender        User        @relation("sentMessages", fields: [senderId], references: [id])
  senderId      String      @db.ObjectId
  
  receiver      User?       @relation("receivedMessages", fields: [receiverId], references: [id])
  receiverId    String?     @db.ObjectId

  groupId       String?     @db.ObjectId
  group         Group?      @relation(fields: [groupId], references: [id])

  type          String      @default("text")
  message       String      
  waveform      Float[]     // مصفوفة أرقام الموجة الصوتية
  messageStatus String      @default("sent")
  createdAt     DateTime    @default(now())

  isEdited      Boolean     @default(false)
  isDeleted     Boolean     @default(false)
  deletedBy     String[]    @db.ObjectId 
  
  replyToId     String?     @db.ObjectId
  replyTo       Messages?   @relation("ReplyRelation", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Messages[]  @relation("ReplyRelation")

  seenBy        MessageSeen[]

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
  @@index([createdAt])
}

model MessageSeen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @db.ObjectId
  message   Messages @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model GroupKey {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  group        Group  @relation(fields: [groupId], references: [id])
  groupId      String @db.ObjectId
  user         User   @relation(fields: [userId], references: [id])
  userId       String @db.ObjectId
  encryptedKey String 
}